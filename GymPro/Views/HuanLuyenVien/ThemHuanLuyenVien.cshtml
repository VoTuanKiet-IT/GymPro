@model GymPro.Models.SetHuanLuyenVienViewModel
@{
    ViewBag.Title = "Thêm Huấn Luyện Viên";
}

<h2>Thêm Huấn Luyện Viên</h2>

@using (Html.BeginForm("ThemHuanLuyenVien", "HuanLuyenVien", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>Huấn Luyện Viên</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        @* Personal Information Fields *@
        <div class="form-group">
            @Html.LabelFor(model => model.HuanLuyenViens.hlv_hodem, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.HuanLuyenViens.hlv_hodem, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.HuanLuyenViens.hlv_hodem, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.HuanLuyenViens.hlv_ten, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.HuanLuyenViens.hlv_ten, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.HuanLuyenViens.hlv_ten, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.HuanLuyenViens.hlv_email, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.HuanLuyenViens.hlv_email, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.HuanLuyenViens.hlv_email, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.HuanLuyenViens.hlv_dienthoai, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.HuanLuyenViens.hlv_dienthoai, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.HuanLuyenViens.hlv_dienthoai, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.HuanLuyenViens.hlv_gioitinh, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <div class="radio">
                    <label>
                        @Html.RadioButtonFor(model => model.HuanLuyenViens.hlv_gioitinh, true) Nam
                    </label>
                </div>
                <div class="radio">
                    <label>
                        @Html.RadioButtonFor(model => model.HuanLuyenViens.hlv_gioitinh, false) Nữ
                    </label>
                </div>
                @Html.ValidationMessageFor(model => model.HuanLuyenViens.hlv_gioitinh, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.ngaysinh, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.ngaysinh, new { htmlAttributes = new { @class = "form-control", @type = "date" } })
                @Html.ValidationMessageFor(model => model.ngaysinh, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.HuanLuyenViens.hlv_diachi, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.HuanLuyenViens.hlv_diachi, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.HuanLuyenViens.hlv_diachi, "", new { @class = "text-danger" })
            </div>
        </div>



        <div class="form-group">
            @Html.LabelFor(model => model.ngaynhanviec, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.ngaynhanviec, new { htmlAttributes = new { @class = "form-control", @type = "date" } })
                @Html.ValidationMessageFor(model => model.ngaynhanviec, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.ChuyenMonDaChon, "Chuyên môn", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @* Thay thế ListBox bằng các Checkbox *@
                @foreach (var chuyenMon in Model.ChuyenMons)
                {
                    <div class="checkbox">
                        <label>
                            <input type="checkbox" name="ChuyenMonDaChon" value="@chuyenMon.chuyenmon_ma" />
                            @chuyenMon.chuyenmon_ten
                        </label>
                    </div>
                }
                @Html.ValidationMessageFor(model => model.ChuyenMonDaChon, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.huanluyenvien_anhdaidien_file, "Ảnh đại diện:", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <input type="file" name="huanluyenvien_anhdaidien_file" id="huanluyenvien_anhdaidien_file" class="form-control" />
                @Html.ValidationMessageFor(model => model.huanluyenvien_anhdaidien_file, "", new { @class = "text-danger" })
            </div>
        </div>

        @* Thêm thẻ <img> này để hiển thị ảnh xem trước *@
        <div class="form-group">
            <div class="col-md-10 col-md-offset-2">
                <img id="imagePreview" src="#" alt="Xem trước ảnh" style="max-width: 200px; max-height: 200px; display: none;" />
            </div>
        </div>

       

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Create" class="btn btn-default" />
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink("Back to List", "HLVListView")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
            $(document).ready(function () {
                // Lắng nghe sự kiện thay đổi trên input file
                $("#huanluyenvien_anhdaidien_file").change(function () {
                    // Kiểm tra xem có file nào được chọn không
                    if (this.files && this.files[0]) {
                        var reader = new FileReader();

                        // Khi file được đọc xong
                        reader.onload = function (e) {
                            // Cập nhật thuộc tính src của thẻ <img>
                            $("#imagePreview").attr('src', e.target.result);
                            // Hiển thị thẻ <img>
                            $("#imagePreview").show();
                        }

                        // Đọc file dưới dạng URL dữ liệu
                        reader.readAsDataURL(this.files[0]);
                    } else {
                        // Nếu không có file, ẩn thẻ <img>
                        $("#imagePreview").hide();
                    }
                });
            });
    </script>
}